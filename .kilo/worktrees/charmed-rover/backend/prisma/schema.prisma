generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  email           String           @unique @db.VarChar(190)
  passwordHash    String           @map("password_hash")
  role            Role             @default(CUSTOMER)
  isActive        Boolean          @default(true) @map("is_active")
  lastLoginAt     DateTime?        @map("last_login_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]

  @@map("users")
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @unique @db.VarChar(100)
  description String    @db.VarChar(300)
  imageUrl    String    @map("image_url") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  name             String           @db.VarChar(140)
  slug             String           @unique @db.VarChar(170)
  shortDescription String           @map("short_description") @db.VarChar(260)
  description      String           @db.Text
  badge            String?          @db.VarChar(40)
  featured         Boolean          @default(false)
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  options          ProductOption[]
  variants         ProductVariant[]

  @@index([categoryId, isActive])
  @@index([featured, isActive])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(180)
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductOption {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  name      String        @db.VarChar(60)
  sortOrder Int           @default(0) @map("sort_order")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    OptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model OptionValue {
  id             String               @id @default(uuid()) @db.Uuid
  optionId       String               @map("option_id") @db.Uuid
  value          String               @db.VarChar(80)
  sortOrder      Int                  @default(0) @map("sort_order")
  option         ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptions VariantOptionValue[]

  @@unique([optionId, value])
  @@map("option_values")
}

model ProductVariant {
  id              String               @id @default(uuid()) @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  sku             String               @unique @db.VarChar(80)
  price           Decimal              @db.Decimal(12, 2)
  previousPrice   Decimal?             @map("previous_price") @db.Decimal(12, 2)
  stock           Int                  @default(0)
  isDefault       Boolean              @default(false) @map("is_default")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values          VariantOptionValue[]
  orderItems      OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String         @map("variant_id") @db.Uuid
  optionValueId String         @map("option_value_id") @db.Uuid
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  orderNumber        String       @unique @map("order_number") @db.VarChar(24)
  status             OrderStatus  @default(AWAITING_CONFIRMATION)
  customerName       String       @map("customer_name") @db.VarChar(120)
  customerPhone      String       @map("customer_phone") @db.VarChar(30)
  department         String       @db.VarChar(80)
  municipality       String       @db.VarChar(100)
  address            String       @db.VarChar(300)
  reference          String?      @db.VarChar(240)
  paymentMethod      String       @map("payment_method") @db.VarChar(80)
  notes              String?      @db.VarChar(500)
  adminNotes         String?      @map("admin_notes") @db.VarChar(1000)
  subtotal           Decimal      @db.Decimal(12, 2)
  deliveryFee        Decimal      @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total              Decimal      @db.Decimal(12, 2)
  inventoryCommitted Boolean      @default(false) @map("inventory_committed")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  items              OrderItem[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  productName    String          @map("product_name") @db.VarChar(140)
  productSlug    String          @map("product_slug") @db.VarChar(170)
  variantLabel   String?         @map("variant_label") @db.VarChar(240)
  sku            String          @db.VarChar(80)
  unitPrice      Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal         @map("line_total") @db.Decimal(12, 2)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model StoreSettings {
  id              Int      @id @default(1)
  storeName       String   @default("UrbanoSV") @map("store_name") @db.VarChar(100)
  whatsappNumber  String   @map("whatsapp_number") @db.VarChar(30)
  supportMessage  String   @default("Atención por WhatsApp") @map("support_message") @db.VarChar(180)
  deliveryMessage String   @default("Entregas disponibles en El Salvador") @map("delivery_message") @db.VarChar(180)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
